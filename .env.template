# Variables del Sistema
PORT=3000

# Variables de la BD
DB_USER=horario
DB_PASS=Aa123456
DB_HOST=localhost

# Docker publica PostgreSQL en el puerto 5433 de la máquina.
DB_PORT=5433
DB_NAME=horarioDB

# Variables de autenticación
JWT_SECRET=horario-backend-secret
JWT_EXPIRES_IN=8h

# Brevo. El código de ingreso y el correo de activación usan este remitente.
# La clave se crea en https://app.brevo.com/settings/keys/api
# El remitente tiene que estar verificado en https://app.brevo.com/senders
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SAHD
FRONTEND_URL=http://localhost:4200

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ACTIVATION_OTP_SECRET=

# Correo del administrador. Se usa solo al ejecutar `pnpm run seed:initial-data`.
# La cuenta se crea sin contraseña.
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=Sistema